    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Cargo launch server",
            "cargo": {
                "args": [
                    "build",
                    "--bin",
                    "file_deploy"
                ]
            },
            "args": [
                "serv",
                "--cert",
                "test_certs/server.crt",
                "--key",
                "test_certs/server.key",
                "-p",
                "123456",
                "."
            ],
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Cargo launch client",
            "cargo": {
                "args": [
                    "build",
                    "--bin",
                    "file_deploy",
                ]
            },
            "args": [
                "deploy",
                "--server",
                "192.168.2.179:4399",
                "--fingerprint",
                "385afaea03a2a2ace1a3d54e5eea14e53eb7766992ede2a0dd0daa67c2d32533",
                "-p",
                "123456",
                "/home/allen/桌面/test_cpp/build/test.exe:C:\\Users\\King\\Desktop"
            ],
            "cwd": "${workspaceFolder}/target/debug",
            "env": {
                "RUST_LOG": "debug"
            }
        },
    ]
}